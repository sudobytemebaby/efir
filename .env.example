# Environment
ENV=development
LOG_LEVEL=info

# Postgres bootstrap
POSTGRES_USER=
POSTGRES_PASSWORD=

# Service databases (connection strings — override per environment)
POSTGRES_AUTH_DSN=
POSTGRES_USER_DSN=
POSTGRES_ROOM_DSN=
POSTGRES_MESSAGE_DSN=

# Service database users
POSTGRES_AUTH_USER=
POSTGRES_AUTH_PASSWORD=
POSTGRES_USER_USER=
POSTGRES_USER_PASSWORD=
POSTGRES_ROOM_USER=
POSTGRES_ROOM_PASSWORD=
POSTGRES_MESSAGE_USER=
POSTGRES_MESSAGE_PASSWORD=

# Valkey
VALKEY_PASSWORD=
VALKEY_ADDR=valkey:6379

# NATS
NATS_URL=nats://nats:4222
NATS_USER=
NATS_PASSWORD=

# JWT (required — never commit a real secret)
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Optional observability
GRAFANA_USER=
GRAFANA_PASSWORD=
